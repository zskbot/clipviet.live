VIDEO_PROVIDER_API_URL=
VIDEO_PROVIDER_API_KEY=
# Exact comma-separated host allowlists; empty means deny direct API/media sources.
VIDEO_API_ALLOWED_HOSTS=
VIDEO_MEDIA_ALLOWED_HOSTS=
# Additional exact iframe host allowlist for non-default providers.
VIDEO_EMBED_ALLOWED_HOSTS=

# Multiple MacCMS V10 JSON APIs. Configure only provider API endpoints you are authorized to access.
# Example: [{"id":"provider-a","name":"Provider A","apiUrl":"https://api.example.com/api.php/provide/vod/"}]
VIDEO_MACCMS_PROVIDERS_JSON=[]
# Add each configured API hostname to VIDEO_API_ALLOWED_HOSTS and each direct media CDN hostname to VIDEO_MEDIA_ALLOWED_HOSTS.

# Public Telegram channel posts only. Use channel username + numeric post ID.
# Example: [{"channel":"official_channel","messageId":"123","title":"Video title","category":"News"}]
# Telegram posts are metadata/source links only; iframe playback is disabled pending rights and safety review.
TELEGRAM_PUBLIC_POSTS_JSON=[]

# Legacy bot importer settings are not used by the public-channel embed integration.

# OCodeJS Admin Control — server-side Preview/Production secrets only
OCODEJS_API_BASE_URL=https://ocodejs.id.vn
OCODEJS_API_TOKEN=
